	<parameterset type="activityParams" ><!-- Personal Business-->
		<param name="activityType" value="personal business" />
		<param name="minimalDuration" value="01:00:00" />
		<param name="typicalDuration" value="02:00:00" />
	</parameterset>

	<parameterset type="activityParams" ><!-- Pickup/Dropoff Someone -->
		<param name="activityType" value="pickup/dropoff someone" />
		<param name="minimalDuration" value="00:10:00" />
