<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<config>
	<module name="global" >
		<param name="coordinateSystem" value="EPSG:28356" />
		<param name="numberOfThreads" value="8" />
		<param name="randomSeed" value="4711" />
	</module>

	<module name="transit">
		<param name="useTransit" value="true" />
		<param name="transitScheduleFile" value="PT/transitSchedule.xml" />
		<param name="vehiclesFile" value="PT/transitVehicles.xml" />
		<param name="transitModes" value="pt" />
	</module>

	<module name="network">
		<param name="inputNetworkFile" value="SEQ_network_modified.xml.gz"/>
	</module>

	<module name="plans">
		<param name="inputPlansFile" value="merged_5pct_all_acts.xml.gz"/>
	</module>

	<module name="qsim">
		<param name="simStarttimeInterpretation" value="onlyUseStarttime"/>
		<param name="simEndtimeInterpretation" value="onlyUseEndtime"/>
		<param name="endTime" value="26:00:00"/>
		<param name="flowCapacityFactor" value="100000.0" />
		<param name="storageCapacityFactor" value="100000.0" />
		<param name="insertingWaitingVehiclesBeforeDrivingVehicles" value="true"/>
		<param name="snapshotStyle" value="queue"/>
		<param name="mainMode" value="car" />
	</module>

	<module name="controler">
		<param name="outputDirectory" value="output/SEQ_Basic/latest-run"/>
		<param name="overwriteFiles" value="deleteDirectoryIfExists"/>
		<param name="firstIteration" value="0"/>
		<param name="lastIteration" value="1"/>
	</module>

	<module name="planCalcScore">
	<parameterset type="scoringParameters" >
	<param name="earlyDeparture" value="-0.0" />
	<param name="lateArrival" value="-18.0" />
	<param name="performing" value="6.0" />
	<param name="marginalUtilityOfMoney" value="1.0" />
	<param name="waitingPt" value="-6.0" />

	<parameterset type="activityParams" ><!-- Home -->
		<param name="activityType" value="home" />
		<param name="minimalDuration" value="08:00:00" />
		<param name="typicalDuration" value="12:00:00" />
	</parameterset>

	<parameterset type="activityParams" ><!-- Direct Work Commute -->
		<param name="activityType" value="direct work commute" />
		<param name="minimalDuration" value="06:00:00" />
		<param name="typicalDuration" value="08:00:00" />
		<param name="openingTime" value="07:00:00" />
		<param name="latestStartTime" value="09:00:00" />
		<param name="closingTime" value="18:00:00" />
